# powerpal-bridge configuration — copy to .env and edit.
# python-dotenv loads this file at startup; real environment variables
# still take precedence over values set here.

# Powerpal BLE MAC address (lowercase) — device sticker, nRF Connect,
# or let the gateway scan by address
POWERPAL_MAC=D8:3F:AE:A6:FD:45

# 6-digit pairing code from the Powerpal app / info pack
# (a leading zero is dropped: "024024" -> 24024)
PAIRING_CODE=123456

# Your meter's pulse constant — MUST match the Powerpal app setting
PULSES_PER_KWH=3200

# Measurement batch window in minutes (1-15)
INTERVAL_MINUTES=1

# true = also subscribe to per-pulse notifications for instantaneous
# watts (chews through the Powerpal battery)
LIVE_PULSE=false

# Seconds between reconnect attempts when the device drops
RETRY_DELAY=15

# home-energy-server ingest endpoint
INGEST_URL=http://192.168.68.141:8000/api/v1/readings

# The server's ingest API key (home-energy-server .env: INGEST_API_KEY)
INGEST_API_KEY=change-me

# Discard readings older than this many seconds — the device replays
# stored history when the batch window is reduced
STALE_SECONDS=300
